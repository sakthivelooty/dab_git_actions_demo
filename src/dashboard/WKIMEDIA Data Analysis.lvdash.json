{
  "datasets": [
    {
      "name": "f59296f0",
      "displayName": "Events per minute",
      "queryLines": [
        "SELECT window_start_timestamp, SUM(event_count) as total_edits\r\n",
        "FROM spark_kafka_projects.wikidata.dashboard_aggregations\r\n",
        "GROUP BY window_start_timestamp ORDER BY window_start_timestamp DESC"
      ]
    },
    {
      "name": "53afaede",
      "displayName": "Events per Domain",
      "queryLines": [
        "SELECT wiki, SUM(event_count) as total_edits\r\n",
        "FROM spark_kafka_projects.wikidata.dashboard_aggregations\r\n",
        "GROUP BY wiki ORDER BY total_edits DESC LIMIT 10"
      ]
    },
    {
      "name": "115108a4",
      "displayName": "Bot vs human",
      "queryLines": [
        "SELECT is_bot, SUM(event_count) as total\r\n",
        "FROM spark_kafka_projects.wikidata.dashboard_aggregations\r\n",
        "GROUP BY is_bot"
      ]
    }
  ],
